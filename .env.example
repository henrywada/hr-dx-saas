# Supabase Configuration（ポートは supabase/config.toml と `supabase status` の API / DB に合わせる）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Vercel: 上記 2 つを Production / Preview に必ず登録しないと、デプロイ後も認証・DB が動きません（未設定時はビルド用ダミーで通過するが API は失敗します）。

# QR 打刻 Edge Functions:
# - ローカル: kong / Docker 内 URL でもフォールバック可（コード側対応済み）。明示するなら supabase/.env に QR_SIGNING_SECRET=16文字以上。
# - 本番（*.supabase.co 等）: 必ず Supabase ダッシュボードまたは `supabase secrets set QR_SIGNING_SECRET=...` で 16 文字以上を設定。
# - ジオフェンス失敗の調査: Next に QR_PUNCH_DEBUG_GEOFENCE=1、Edge qr-scan 用に supabase secrets set QR_PUNCH_DEBUG_GEOFENCE=1（本番では調査後に削除）
# QR_PUNCH_DEBUG_GEOFENCE=1

# Server-side environment variables
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database URL for direct connections
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# OpenRouter（AI人事アシスタント・人事アップデート収集で使用。サーバー専用のため NEXT_PUBLIC_ は付けない）
# 取得: https://openrouter.ai/keys
# チャット・要約・埋め込み・週次 web_search/web_fetch に使用。web_search はクレジット課金あり
OPENROUTER_API_KEY=

# Google Gemini（他機能の AI Server Action で使用。人事アシスタント本線は OpenRouter）
# 取得: https://aistudio.google.com/apikey ／ 個人情報を扱うため必ず有料(paid)ティアを使用すること
GEMINI_API_KEY=

# 文書ホルダー OCR（Gemini Vision）
GEMINI_VISION_MODEL=gemini-2.5-flash

# ポータル「人事へメール」の宛先は管理画面 /adm/settings（tenant_portal_settings.hr_inquiry_email）のみ。以下は別用途向けの例
# HR_INQUIRY_EMAIL=hr-inquiry@example.com
# HR_ALERT_EMAIL_DEFAULT=hr@example.com

# 新規契約（セルフサービス サインアップ完了）の運営者向け通知先
# 未設定時は src/lib/mail/send.ts の DEFAULT_SIGNUP_ADMIN_EMAIL に送信される
# SIGNUP_ADMIN_NOTIFY_EMAIL=wada007@gmail.com

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development

# Content-Security-Policy の適用モード（src/lib/security/headers.ts）
# 未設定 = enforce：違反を実際にブロックする（既定）
# report-only     ：違反をブラウザのコンソールに記録するだけでブロックしない
# 本番で想定外の違反により画面が壊れた場合の緊急退避として、Vercel の環境変数に
# CSP_MODE=report-only を設定すれば再ビルドなしで即座にブロックを止められる。
# 復旧後は環境変数を削除して enforce に戻すこと。
# CSP_MODE=report-only

# 開発・テスト用: 高ストレス者画面を任意ロールでプレビュー可能にする
# ENABLE_HIGH_STRESS_PREVIEW=true          # 人事用 /adm/high-stress
# ENABLE_HIGH_STRESS_FOLLOWUP_PREVIEW=true # 産業医用 /adm/high-stress-followup

# Stripe Configuration（セルフサービス サインアップフロー）
# テスト: https://dashboard.stripe.com/test/apikeys
# 本番:   https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# SerpAPI（求人検索・採用市場分析・自動配信ルールのWeb検索で使用）
# 取得: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# 自動配信ルール cron 認証用シークレット（GitHub Actions の Secrets と Vercel 環境変数の両方に同じ値を設定）
DISTRIBUTION_CRON_SECRET=

# 助成金情報配信（/adm/grant-notifier ・ /saas_adm/grant-notifier）
# J-グランツAPI ベースURL（公開API・APIキー不要）
JGRANTS_API_BASE_URL=https://api.jgrants-portal.go.jp/exp/v1/public
# 週次バッチ cron 認証用シークレット（GitHub Actions Secrets と Vercel 環境変数の両方に同じ値を設定）
GRANT_NOTIFIER_CRON_SECRET=
# 配信停止リンクのトークン署名鍵（十分な長さのランダム文字列。変更すると既存リンクが無効になる）
UNSUBSCRIBE_SECRET=

# 情報掲示板（/adm/notion_info）— Notion Internal Integration。NEXT_PUBLIC_ は付けない
# 3つのデータベースを Integration に Share すること
NOTION_API_KEY=
NOTION_DB_HR_TREND_ID=3da121bf-139a-80dd-8e33-cecfe7cce9a3
NOTION_DB_GRANT_ID=3da121bf-139a-80a4-bd40-e1569a8433e3
NOTION_DB_AI_ID=3da121bf-139a-80ee-92ce-d5e9a8e9fb16

# LINE連携（全テナント共用の公式アカウント + LIFF）
# LINE_LOGIN_CHANNEL_ID は JWT の aud（数値チャネルID）。NEXT_PUBLIC_LIFF_ID とは別物。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
